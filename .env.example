# Read by contracts/evm/test/* and apps/web/scripts/alpenglow-deploy.ts.
# Copy to .env (git-ignored). Testnet keys only.

# EVM key that pays gas on the destination chain (Base Sepolia ETH or BNB
# testnet tBNB). The web app also seeds its simulated validator set from it.
SEPOLIA_FUNDER_KEY=

# Destination RPCs. Public endpoints are used when these are unset.
# ALPENGLOW_BASE_RPC_URL=https://sepolia.base.org
# ALPENGLOW_BSC_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Local Alpenglow node addresses (defaults shown).
# LOCAL_RPC=http://127.0.0.1:8899
# LOCAL_GRPC=127.0.0.1:10000
# INCLUSION_TOOL=crates/shred-inclusion/target/release/shred-inclusion
