# Copy to apps/web/.env (git-ignored). Testnet keys only.

# Required. Relayer for certificates and actions, and the seed of the
# simulated validator set used on devnet.
SEPOLIA_FUNDER_KEY=

# Optional. A Solana key (JSON byte array) the server can sign approvals with
# when no wallet is connected. Falls back to ~/.config/solana/id.json.
# ALPENGLOW_DEVNET_KEY_JSON=

# Solana endpoints (defaults shown).
# ALPENGLOW_SOLANA_RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC_ALPENGLOW_SOLANA_RPC_URL=https://api.devnet.solana.com
# ALPENGLOW_LOCAL_RPC_URL=http://127.0.0.1:8899
# NEXT_PUBLIC_ALPENGLOW_LOCAL_RPC_URL=http://127.0.0.1:8899
# ALPENGLOW_LOCAL_GRPC=127.0.0.1:10000
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC_SOLANA_WS_URL=

# Destination RPCs. Public endpoints are used when these are unset.
# ALPENGLOW_BASE_RPC_URL=https://sepolia.base.org
# ALPENGLOW_BSC_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# NEXT_PUBLIC_DOCS_URL=https://frontier-docs-cazz.vercel.app
